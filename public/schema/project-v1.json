{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "default": "",
      "type": "string",
      "maxLength": 2000
    },
    "width": {
      "type": "integer",
      "minimum": 256,
      "maximum": 3840
    },
    "height": {
      "type": "integer",
      "minimum": 256,
      "maximum": 3840
    },
    "fps": {
      "anyOf": [
        {
          "type": "number",
          "const": 24
        },
        {
          "type": "number",
          "const": 25
        },
        {
          "type": "number",
          "const": 30
        },
        {
          "type": "number",
          "const": 60
        }
      ]
    },
    "scenes": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "type": {
            "type": "string",
            "enum": [
              "website",
              "saas",
              "glass",
              "product",
              "mobile",
              "tech",
              "typography",
              "education",
              "before-after",
              "brand",
              "orbit",
              "business"
            ]
          },
          "startFrame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 108000
          },
          "duration": {
            "type": "integer",
            "minimum": 1,
            "maximum": 108000
          },
          "background": {
            "default": "#09090B",
            "type": "string",
            "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
          },
          "accent": {
            "default": "#2563EB",
            "type": "string",
            "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
          },
          "title": {
            "type": "string",
            "maxLength": 1000
          },
          "subtitle": {
            "default": "",
            "type": "string",
            "maxLength": 2000
          },
          "eyebrow": {
            "default": "NOVA STUDIO",
            "type": "string",
            "maxLength": 200
          },
          "layers": {
            "default": [],
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "name": {
                  "type": "string",
                  "maxLength": 200
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "text",
                    "image",
                    "video",
                    "audio",
                    "shape",
                    "model"
                  ]
                },
                "trackId": {
                  "type": "string",
                  "maxLength": 100
                },
                "startFrame": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 108000
                },
                "duration": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 108000
                },
                "x": {
                  "default": 50,
                  "type": "number",
                  "minimum": -200,
                  "maximum": 200
                },
                "y": {
                  "default": 50,
                  "type": "number",
                  "minimum": -200,
                  "maximum": 200
                },
                "width": {
                  "default": 80,
                  "type": "number",
                  "minimum": 1,
                  "maximum": 400
                },
                "height": {
                  "default": 20,
                  "type": "number",
                  "minimum": 1,
                  "maximum": 400
                },
                "rotation": {
                  "default": 0,
                  "type": "number",
                  "minimum": -3600,
                  "maximum": 3600
                },
                "scale": {
                  "default": 1,
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 20
                },
                "opacity": {
                  "default": 1,
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "zIndex": {
                  "default": 1,
                  "type": "integer",
                  "minimum": -100,
                  "maximum": 100
                },
                "text": {
                  "default": "",
                  "type": "string",
                  "maxLength": 10000
                },
                "assetId": {
                  "type": "string",
                  "maxLength": 100
                },
                "color": {
                  "default": "#F8FAFC",
                  "type": "string",
                  "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                },
                "fontSize": {
                  "default": 80,
                  "type": "number",
                  "minimum": 8,
                  "maximum": 500
                },
                "fontFamily": {
                  "default": "Inter",
                  "type": "string",
                  "pattern": "^(?:Inter|Vazirmatn|Georgia|monospace|asset:[a-zA-Z0-9_-]{1,100})$"
                },
                "fontWeight": {
                  "default": 600,
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 900
                },
                "direction": {
                  "default": "auto",
                  "type": "string",
                  "enum": [
                    "auto",
                    "ltr",
                    "rtl"
                  ]
                },
                "align": {
                  "default": "center",
                  "type": "string",
                  "enum": [
                    "left",
                    "center",
                    "right"
                  ]
                },
                "animation": {
                  "default": "fade",
                  "type": "string",
                  "enum": [
                    "none",
                    "fade",
                    "slide",
                    "scale",
                    "spring",
                    "stagger",
                    "typewriter",
                    "float",
                    "orbit",
                    "mask",
                    "perspective",
                    "parallax",
                    "elastic"
                  ]
                },
                "keyframes": {
                  "default": [],
                  "maxItems": 1000,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "maxLength": 100
                      },
                      "frame": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 108000
                      },
                      "property": {
                        "type": "string",
                        "enum": [
                          "x",
                          "y",
                          "scale",
                          "rotation",
                          "opacity",
                          "blur",
                          "fontSize",
                          "volume",
                          "cameraX",
                          "cameraY",
                          "cameraZ"
                        ]
                      },
                      "value": {
                        "type": "number",
                        "minimum": -10000,
                        "maximum": 10000
                      },
                      "easing": {
                        "default": "ease-in-out",
                        "type": "string",
                        "enum": [
                          "linear",
                          "ease-in",
                          "ease-out",
                          "ease-in-out",
                          "spring"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "frame",
                      "property",
                      "value"
                    ],
                    "additionalProperties": false
                  }
                },
                "volume": {
                  "default": 1,
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2
                },
                "trimStart": {
                  "default": 0,
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 108000
                },
                "visible": {
                  "default": true,
                  "type": "boolean"
                },
                "groupId": {
                  "type": "string",
                  "maxLength": 100
                }
              },
              "required": [
                "id",
                "name",
                "type",
                "trackId",
                "startFrame",
                "duration"
              ],
              "additionalProperties": false
            }
          },
          "transition": {
            "default": "fade",
            "type": "string",
            "enum": [
              "fade",
              "slide",
              "zoom",
              "blur",
              "wipe",
              "flash",
              "glitch",
              "rotate",
              "none"
            ]
          },
          "transitionDuration": {
            "default": 18,
            "type": "integer",
            "minimum": 0,
            "maximum": 120
          },
          "effects": {
            "default": [
              "grain",
              "vignette"
            ],
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "grain",
                "vignette",
                "bloom",
                "scanlines",
                "chromatic",
                "particles",
                "light-sweep",
                "glass"
              ]
            }
          },
          "camera": {
            "default": {
              "projection": "perspective",
              "path": "orbit",
              "intensity": 0.6,
              "fov": 42
            },
            "type": "object",
            "properties": {
              "projection": {
                "default": "perspective",
                "type": "string",
                "enum": [
                  "perspective",
                  "orthographic"
                ]
              },
              "path": {
                "default": "orbit",
                "type": "string",
                "enum": [
                  "orbit",
                  "dolly-in",
                  "dolly-out",
                  "truck",
                  "crane",
                  "static"
                ]
              },
              "intensity": {
                "default": 0.6,
                "type": "number",
                "minimum": 0,
                "maximum": 3
              },
              "fov": {
                "default": 42,
                "type": "number",
                "minimum": 15,
                "maximum": 120
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "startFrame",
          "duration",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "tracks": {
      "minItems": 1,
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "type": {
            "type": "string",
            "enum": [
              "scene",
              "text",
              "image",
              "video",
              "audio",
              "shape",
              "model",
              "effect",
              "camera"
            ]
          },
          "locked": {
            "default": false,
            "type": "boolean"
          },
          "hidden": {
            "default": false,
            "type": "boolean"
          },
          "muted": {
            "default": false,
            "type": "boolean"
          },
          "solo": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "assets": {
      "default": [],
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "type": {
            "type": "string",
            "enum": [
              "image",
              "video",
              "audio",
              "font",
              "model"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^\\/storage\\/assets\\/[a-zA-Z0-9_-]+\\.[a-zA-Z0-9]+$"
          },
          "mime": {
            "type": "string",
            "maxLength": 100
          },
          "size": {
            "type": "number",
            "minimum": 0,
            "maximum": 104857600
          },
          "tags": {
            "default": [],
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100
            }
          },
          "folder": {
            "default": "Library",
            "type": "string",
            "maxLength": 100
          },
          "createdAt": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "path",
          "mime",
          "size",
          "createdAt"
        ],
        "additionalProperties": false
      }
    },
    "brand": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "primary": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "secondary": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "background": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "font": {
          "type": "string",
          "enum": [
            "Inter",
            "Vazirmatn",
            "Georgia",
            "monospace"
          ]
        },
        "cta": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "name",
        "primary",
        "secondary",
        "background",
        "font",
        "cta"
      ],
      "additionalProperties": false
    },
    "archived": {
      "default": false,
      "type": "boolean"
    },
    "createdAt": {
      "type": "string",
      "maxLength": 100
    },
    "updatedAt": {
      "type": "string",
      "maxLength": 100
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "width",
    "height",
    "fps",
    "scenes",
    "tracks",
    "brand",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
