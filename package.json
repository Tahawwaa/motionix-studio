{
  "name": "nova-motion-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx scripts/dev.ts",
    "dev:studio": "vite --host 127.0.0.1",
    "dev:worker": "node --env-file-if-exists=.env --import tsx services/render-worker/server.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx scripts/dev.ts --production",
    "stop": "node --env-file-if-exists=.env --import tsx scripts/stop.ts",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"apps/studio/src/**/*.{ts,tsx,css}\" \"packages/**/*.{ts,tsx}\" \"services/**/*.{ts,tsx}\" \"scripts/*.ts\" \"tests/**/*.ts\" \"*config.ts\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "setup": "node --env-file-if-exists=.env --import tsx scripts/setup.ts",
    "migrate": "php apps/backend/artisan migrate --force",
    "health": "node --env-file-if-exists=.env --import tsx scripts/health.ts",
    "mcp": "node --env-file-if-exists=.env --import tsx services/mcp-server/index.ts",
    "mcp:http": "node --env-file-if-exists=.env --import tsx services/mcp-server/index.ts --http",
    "demo:render": "node --env-file-if-exists=.env --import tsx scripts/render-demos.ts",
    "schema": "node --import tsx scripts/export-schema.ts",
    "test:backend": "node --import tsx scripts/test-backend.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "7.0.8",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@remotion/bundler": "4.0.545",
    "@remotion/player": "4.0.545",
    "@remotion/renderer": "4.0.545",
    "@remotion/three": "4.0.545",
    "@tanstack/react-query": "5.108.2",
    "cors": "2.8.6",
    "express": "5.3.0",
    "ffprobe-static": "3.1.0",
    "lucide-react": "1.77.0",
    "multer": "2.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "remotion": "4.0.545",
    "sharp": "0.35.5",
    "three": "0.187.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
